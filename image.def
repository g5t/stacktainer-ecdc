Bootstrap: docker
From: almalinux:9

%arguments
efu_name="event-formation-unit"
# The artifactory artifact. A release tag or a git revision; ecdc-fetch.py takes
# either. Tags live under .../event-formation-unit/tags/<tag>/ rather than a
# branch directory, which is why there is no longer a branch argument here.
efu_revision="3.1.0"
# The git ref the JSON module configurations are cloned from. Keep it equal to
# efu_revision: the configs then come from the same commit the binaries were
# built at, which they did not when this tracked master. Tag 3.1.0 peels to
# 51fb108d, the revision artifactory built as master build 2042.
efu_ref="3.1.0"
# GitHub's mirror is not syncing; the in-house GitLab is authoritative.
efu_remote="https://gitlab.esss.lu.se/ecdc/ess-dmsc/event-formation-unit.git"
writer_name="kafka-to-nexus"
writer_revision="6.4.6"
streaming_remote="https://github.com/g5t/python-streaming-data-types.git@numpy-2"
forwarder_remote="https://github.com/g5t/ess-forwarder.git@splitrun"
ecdc_dist="almalinux9"


%files
ecdc-fetch.py /opt/ecdc-fetch.py

%post

dnf install -y jq git libxcrypt-compat python3.12 python3.12-pip which
ln -s $(which python3.12) /usr/bin/python
python -m pip install --break-system-packages git+{{ streaming_remote }} git+{{ forwarder_remote }}

# Use the ECDC provided binaries instead of building them. ecdc-fetch.py takes a
# git revision or a release tag alike -- whatever sits between the package name
# and the distribution in the artifact filename -- and fails loudly if it does not
# resolve to exactly one artifact. The shell function this replaced piped an empty
# result into tar and, with no `set -e` here, left an image with no binaries in it.
python /opt/ecdc-fetch.py --dist {{ ecdc_dist }} {{ efu_name }} {{ efu_revision }}
python /opt/ecdc-fetch.py --dist {{ ecdc_dist }} {{ writer_name }} {{ writer_revision }}

# clone the EFU repo to grab module configuration files
git clone -b {{ efu_ref }} --depth 1 {{ efu_remote }} /efu
cd /efu/src/modules && find -type f -name "*.json" -exec cp --parents "{}" /{{ efu_name }}/configs/ \;
cd /
rm -rf /efu

rm -f /opt/ecdc-fetch.py

dnf clean all


%environment
export LC_ALL=C
export PYTHONPATH=/usr/local/lib/python3.12/site-packages/:/usr/local/lib64/python3.12/site-packages
export EFU_VERSION={{ efu_revision }}
export FILEWRITER_VERSION={{ writer_revision }}
export PATH=$PATH:/{{ efu_name }}/bin:/{{ efu_name }}/util/efushell/:/{{ writer_name }}/bin
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/{{ efu_name }}/lib

%help
Data collection utilities for the European Spallation Source.
Event Formation Unit binaries:
	bifrost  - the indirect geometry time-of-flight spectrometer, BIFROST
	cbm      - beam monitors used a multiple instruments
	cspec    - the direct geometry time-of-flight spectrometer, CSPEC
	dream    - the powder diffractometer, DREAM
	freia    - the reflectometer, FREIA
	loki     - the small angle scattering diffractometer, LOKI
	miracles - the back scattering time-of-flight spectrometer, MIRACLES
	nmx      - the macromollecular single crystal diffractometer, NMX
	timepix3 - the TimePix3 clustering photon imaging detector, used at ODIN
	trex     - the direct geometry time-of-flight spectrometer, TREX
Event Formation Unit shell utilities:
	efubriefstat.py  - query a running EFU for statistics
	efucalibmode.py  - set or query the EFU calibration mode value
	efurates.py      - print rates change of EFU counters
	efustats.py      - print all EFU counters
	efustatstocsv.py - produce a CSV file of EFU counters
	efustatus.py     - print the status of a running EFU
	getstat.py       - print the value of a specified counter
	isefurunning.py  - check if an EFU is running
	verifymetrics.py - compare an EFU counter value to a specified value
File Writer binaries:
	kafkfa-to-nexus - the worker responsible for writing streams to NeXus files
	file-maker      - convert NeXusStructure JSON and flatbuffer data to NeXus HDF5
	template-maker  - convert NeXusStructure JSON to template NeXus HDF5
EPICS to Kafka forwarder programs:
	forwarder-launch - create the process to send EPICS updates to a Kafka server

%test
function test_revision(){
  expected="$2"
  for b in "${@:3}"
  do
    echo -n "Check $b version ... "
    res=$($b --version)
    if (echo $res | grep -q "${expected}")
    then
       echo "success!"
    else
       echo "${expected} not in $res"
       return 1
    fi
  done
}
test_result=0
# SKIP ALL TESTING (for now)
# The EFU binaries now report "dev" for version when built from the tip of the repository
# test_revision {{ efu_revision }} bifrost cbm cspec dream freia loki miracles nmx timepix3 trex || test_result=1
# And the file writer binaries report "HEAD-{git commit id:0:7}" which is less than the partial hash in the artifactory filename
# test_revision {{ writer_revision }} kafka-to-nexus || test_result=1
exit ${test_result}

